{
  "name": "bingcool/library",
  "description": "library is a common library attach to swoole extension, for everyone use it easily!",
  "keywords": [
    "workerfy",
    "swoole",
    "php",
    "library"
  ],
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "bingcool",
      "email": "2437667702@qq.com",
      "role": "library of swoole"
    }
  ],
  "minimum-stability": "dev",
  "require": {
    "php" : "^7.4|^8.0",
    "ext-pdo": "*",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-redis": "*",
    "ext-openssl": "*",
    "psr/clock": "*",
    "predis/predis": "~2.2.1",
    "malkusch/lock": "~2.2.0",
    "php-amqplib/php-amqplib": "~3.5.0",
    "php-http/discovery": "^1.14",
    "psr/http-client-implementation": "^1.0",
    "psr/http-factory-implementation": "^1.0",
    "psr/http-client": "^1.0",
    "psr/http-message": "^1.0.1|^2.0",
    "psr/log": "^1.1|^2.0|^3.0",
    "ramsey/uuid": "^3.0 || ^4.0",
    "symfony/polyfill-mbstring": "^1.23",
    "symfony/polyfill-php82": "^1.26",
    "tbachert/spi": "^1.0.5",
    "google/protobuf": "^3.22 || ^4.0",
    "symfony/http-client": "7.4.x-dev",
    "nyholm/psr7": "^1.8@dev",
    "guzzlehttp/guzzle": "~7.9.3"
  },
  "require-dev": {
    "kwn/php-rdkafka-stubs": "@dev",
    "swoole/ide-helper": "@dev",
    "phpunit/phpunit": ">=7.2.0"
  },
  "autoload": {
    "psr-4": {
      "Common\\Library\\": "src/",
      "Opentelemetry\\Proto\\": "src/Opentelemetry/gen-otlp-protobuf/Opentelemetry/Proto/",
      "GPBMetadata\\Opentelemetry\\": "src/Opentelemetry/gen-otlp-protobuf/GPBMetadata/Opentelemetry/"
    },
    "files": [
      "src/Helper.php",
      "src/OpenTelemetry/Context/fiber/initialize_fiber_handler.php",
      "src/OpenTelemetry/Contrib/Otlp/_register.php",
      "src/OpenTelemetry/SDK/Common/Util/functions.php",
      "src/OpenTelemetry/SDK/Logs/Exporter/_register.php",
      "src/OpenTelemetry/SDK/Metrics/MetricExporter/_register.php",
      "src/OpenTelemetry/SDK/Propagation/_register.php",
      "src/OpenTelemetry/SDK/Trace/SpanExporter/_register.php",
      "src/OpenTelemetry/SDK/Common/Dev/Compatibility/_load.php",
      "src/OpenTelemetry/SDK/_autoload.php",
      "src/OpenTelemetry/API/Trace/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Common\\Library\\Tests\\": "tests/"
    }
  }
}
